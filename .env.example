# Local / development. Production Fly sets NODE_ENV=production via fly.engine.toml.
NODE_ENV=development
TRADING_MODE=paper
NAKED_DIRECTIONAL_SOAK_ENABLED=false
PORT=8080
LOG_LEVEL=info

# Canonical journal. Copy the URI from Supabase Dashboard → Database → Connect.
# Prefer DIRECT Postgres (db.<project-ref>.supabase.co:5432, SSL). Fallback: Supavisor
# SESSION mode on port 5432. Never transaction mode for the long-lived engine.
# Do not put the real password in git. Replace REPLACE_ME locally or via `fly secrets`.
DATABASE_URL=postgres://postgres:REPLACE_ME@localhost:5432/polymarket
JOURNAL_MODE=postgres

PAPER_START_BALANCE=1000
PAPER_EXECUTION_LATENCY_MS=150
PAPER_EXECUTION_STYLE=TAKER
# NORMAL HEDGE_SECOND_LEG gross locked pair edge floor. Default preserves canonical behavior.
NORMAL_HEDGE_MIN_LOCKED_PAIR_EDGE=0.015
EXPERIMENT_DURATION_HOURS=48
EXPERIMENT_CLOSE_POLICY=observe_until_settlement
ENGINE_REGION=fra
POLYMARKET_MARKET_SLUGS=
POLYMARKET_TOKEN_IDS=
REFERENCE_WS_BASE_URL=wss://data-stream.binance.vision/ws
REFERENCE_REST_BASE_URL=https://api.binance.com

# Grok MCP is NOT required for MONITOR_ONLY boot. Configure later before 48h experiment.
# GROK_MCP_BEARER_TOKENS=market_microstructure_scanner:replace-with-high-entropy-token
GROK_MCP_ALLOWED_ORIGINS=https://grok.com,https://x.ai
GROK_MCP_RATE_LIMIT_PER_MINUTE=60
# OAuth 2.1 Custom Connector compatibility is explicit opt-in; keep disabled by default.
GROK_MCP_OAUTH_ENABLED=false
# Set to the public engine origin when enabling OAuth; no real secret belongs in git.
# GROK_MCP_OAUTH_ISSUER=https://mstfgncr-polymarket-engine.fly.dev
# One operator approval secret for the browser authorization page. Role authority comes from the protected resource, not this secret.
# GROK_MCP_OAUTH_APPROVAL_SECRET=replace-with-high-entropy-secret
# GROK_MCP_OAUTH_BOOTSTRAP_TOKENS is deprecated and ignored by the production OAuth approval wiring.
# GROK_MCP_OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
# GROK_MCP_OAUTH_AUTH_CODE_TTL_SECONDS=300
GROK_ACTIVATION_PROVIDER=noop
# xAI is explicit opt-in; a key alone never enables paid inference.
# XAI_API_KEY=
# XAI_API_BASE_URL=https://api.x.ai/v1
# XAI_MODEL=                 # required when GROK_ACTIVATION_PROVIDER=xai
# XAI_REQUEST_TIMEOUT_MS=20000
# XAI_MAX_OUTPUT_TOKENS=1024
# XAI_ALLOW_PORTFOLIO_CONTEXT=false
# Bounded hot scout research working set (role-specific TTLs, process-local only).
# XAI_SCOUT_CACHE_MAX_ENTRIES=128
# XAI_SCOUT_MICRO_TTL_MS=5000
# XAI_SCOUT_CRYPTO_TTL_MS=15000
# XAI_SCOUT_NEWS_TTL_MS=60000

# Slack wake-signal is later. Never put these on the dashboard or in git.
# SLACK_BOT_TOKEN=
# SLACK_CHANNEL_ID=

ESTIMATED_INFRA_COST_PER_HOUR_USD=0.08
SETTLEMENT_POLL_MS=15000
DASHBOARD_SNAPSHOT_HZ=4
TELEMETRY_QUEUE_LIMIT=2000
ACTIVATION_MEMORY_LIMIT=500
EXPERIMENT_REQUIRES_GROK=false

# Retention is opt-in. Missing/false does not delete journal rows. Enable only after dry-run review.
RETENTION_ENABLED=false
# RETENTION_MAX_BATCHES_PER_CYCLE=20
# RETENTION_MAX_ROWS_PER_CYCLE=4000

# Native V2 learning memory (PR1). Default false — production unchanged until opt-in.
# Requires a persistent host mount at LEARNING_DATA_DIR (see docs/LEARNING.md).
LEARNING_ENABLED=false
LEARNING_DATA_DIR=/data/learning
# Operational DEFAULT byte cap (not a measured capacity requirement).
LEARNING_MAX_BYTES=256000000
LEARNING_CHECKPOINT_SECONDS=240,180,120,60,30,15,5
# LEARNING_SETTLEMENT_POLL_MS=15000
# PR5 learned shadow (advisory only; default off). Requires verified candidate.
LEARNING_SHADOW_ENABLED=false
# LEARNING_SHADOW_MODEL_PATH=/data/learning/artifacts/candidate.json
# LEARNING_SHADOW_MODEL_ID=cand-abc123
# Controlled PAPER authority path is NOT wired in PR5 (see docs/LEARNING.md).
LEARNING_PAPER_AUTHORITY_ENABLED=false
# LEARNING_PAPER_AUTHORITY_MODEL_ID=

# --- Engine (Fly) ---
# Server-side only. Dashboard proxy sends ENGINE_READ_TOKEN; never NEXT_PUBLIC_ / never browser JS.
ENGINE_READ_TOKEN=replace-with-high-entropy-read-token
# Required in production. Exclusive operator mutations. Never fall back from the read token. Never on Vercel.
ENGINE_OPERATOR_TOKEN=replace-with-high-entropy-operator-token
# METRICS_TOKEN=replace-with-optional-metrics-token
DASHBOARD_ORIGIN=http://localhost:3000

# --- Dashboard (Vercel server-only; never NEXT_PUBLIC_) ---
# Same ENGINE_READ_TOKEN name as Fly. Set both in the Vercel project as server env (not browser).
ENGINE_INTERNAL_URL=http://localhost:8080
# Optional. SSE proxy lifetime in ms, armed before the Fly fetch (connect + stream). Default 240000. Hard-capped at 270000 (below Vercel's ~300s kill). Tests may use a short value.
# SSE_PROXY_MAX_MS=240000
