# syntax=docker/dockerfile:1.7
FROM node:22-bookworm-slim AS build
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /workspace
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/engine/package.json apps/engine/package.json
COPY packages/core/package.json packages/core/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/market-data/package.json packages/market-data/package.json
RUN pnpm install --frozen-lockfile
COPY apps/engine apps/engine
COPY packages packages
RUN pnpm --filter @pm/engine typecheck && pnpm --filter @pm/engine build

FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production
WORKDIR /app
RUN groupadd --system engine && useradd --system --gid engine --home /app engine
COPY --from=build --chown=engine:engine /workspace/apps/engine/dist ./dist
COPY --from=build --chown=engine:engine /workspace/packages/db/migrations ./packages/db/migrations
USER engine
EXPOSE 8080
CMD ["node", "dist/main.js"]
