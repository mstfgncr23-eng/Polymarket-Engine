+  private async pollLearningSettlements(): Promise<void> {
+    if (!this.learningStore) return;
+    const now = this.nowFn();
+    const intervalMs = this.env.LEARNING_SETTLEMENT_POLL_MS ?? this.env.SETTLEMENT_POLL_MS;
