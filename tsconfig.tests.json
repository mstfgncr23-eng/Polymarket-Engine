{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM"],
    "rootDir": ".",
    "exactOptionalPropertyTypes": false,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "paths": {
      "@pm/core": ["./packages/core/src/index.ts"],
      "@pm/db": ["./packages/db/src/index.ts"],
      "@pm/market-data": ["./packages/market-data/src/index.ts"]
    }
  },
  "include": [
    "tests/guardian-v2.test.ts",
    "tests/guardian-v2-report.test.ts",
    "tests/reversal-protection-paper.test.ts",
    "tests/reversal-protection.test.ts",
    "tests/native-hotpath-fossils.test.ts",
    "scripts/native-hotpath-bench.ts",
    "tests/protective-min-order-rest-hydration.test.ts",
    "tests/normalization-reference.ts",
    "tests/dashboard-low-impact.test.ts",
    "tests/trading-results-durable.test.ts"
  ]
}
