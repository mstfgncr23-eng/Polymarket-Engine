{
  "name": "polymarket-research-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev:engine": "pnpm --filter @pm/engine dev",
    "dev:dashboard": "pnpm --filter @pm/dashboard dev",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "pnpm --filter @pm/engine smoke",
    "smoke:astra": "pnpm --filter @pm/engine smoke:astra",
    "smoke:live": "pnpm --filter @pm/engine smoke:live",
    "experiment:start": "pnpm --filter @pm/engine experiment:start",
    "report": "pnpm --filter @pm/engine report",
    "archive:export": "pnpm --filter @pm/engine archive:export",
    "bench:stability": "tsx scripts/stability-hot-path-bench.ts",
    "bench:sustained": "tsx scripts/sustained-capacity-harness.ts",
    "bench:retention": "tsx scripts/report-retention-bench.ts",
    "galaxy:runtime-proof": "node apps/dashboard/scripts/galaxy-runtime-proof.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "26.4.0",
    "playwright": "^1.63.0",
    "tsup": "8.5.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
